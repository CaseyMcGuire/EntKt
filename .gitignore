entkt.iml
# Ignore Gradle project-specific cache directory
.gradle
.gradle-local
.kotlin

# Ignore Gradle build output directory
build

# Claude Code
.claude/worktrees

.gradle-cache

# macOS metadata — gitignore patterns are case-sensitive (even on
# HFS+/APFS), so the actual `.DS_Store` filename has to match exactly.
# `**/` makes the pattern apply to subdirectories too.
.DS_Store
**/.DS_Store.claude/
